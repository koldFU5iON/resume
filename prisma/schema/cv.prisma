// ------------------------------------------------------------
// CV BUILDER
// ------------------------------------------------------------

model CVTemplate {
  id          String   @id @default(cuid())
  name        String
  region      String   @default("global")
  description String
  sections    String   @default("[]")
  isDefault   Boolean  @default(false)
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())

  cvDocuments CVDocument[]
}

model CVDocument {
  id               String   @id @default(cuid())
  profileId        String
  jobApplicationId String?
  careerVerticalId String?
  templateId       String
  jobDescription    String?
  jobTitle          String?
  company           String?
  generatedContent  String   @default("{}")
  /// generating | draft | failed | accepted. `accepted` marks the CV that was
  /// (or will be) sent for the job; see src/modules/cv/acceptance.ts.
  status            String   @default("draft")
  /// When the CV was accepted; null unless status is "accepted".
  acceptedAt        DateTime?
  /// How it was accepted: "manual" (CV builder) or "applied" (job moved to applied).
  acceptedVia       String?
  masterCvUpdatedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  profile         Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  template        CVTemplate      @relation(fields: [templateId], references: [id])
  jobApplication  JobApplication? @relation(fields: [jobApplicationId], references: [id])
  careerVertical  CareerVertical? @relation(fields: [careerVerticalId], references: [id])
  coverLetters    CoverLetterDocument[]
  writingDeskSources WritingDeskDocument[] @relation("WritingDeskSourceCV")
  llmUsageLogs       LlmUsageLog[]

  @@index([profileId])
  @@index([jobApplicationId, status])
}
