// ------------------------------------------------------------
// WRITING DESK
// ------------------------------------------------------------

// A job can hold several named documents (#370). The oldest (createdAt, id)
// is the job's primary document: the one job-scoped links resolve to.
model WritingDeskDocument {
  id                 String    @id @default(cuid())
  profileId          String
  jobApplicationId   String
  name               String    @default("Untitled document")
  documentType       String?
  content            String    @default("")
  revision           Int       @default(1)
  sourceType         String?
  sourceCvDocumentId String?
  sourceLabel        String?
  draftContent       String?
  draftRevision      Int       @default(0)
  draftUpdatedAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  profile        Profile                 @relation(fields: [profileId], references: [id], onDelete: Cascade)
  jobApplication JobApplication          @relation(fields: [jobApplicationId], references: [id], onDelete: Cascade)
  sourceCv       CVDocument?             @relation("WritingDeskSourceCV", fields: [sourceCvDocumentId], references: [id], onDelete: SetNull)
  draftEvents    WritingDeskDraftEvent[]

  @@index([profileId])
  @@index([jobApplicationId, createdAt])
  @@index([sourceCvDocumentId])
}

// Provenance log for agent writes to a desk's draft. Never rendered into
// document content.
model WritingDeskDraftEvent {
  id            String   @id @default(cuid())
  writingDeskId String
  apiTokenId    String?
  tool          String
  detail        Json?
  createdAt     DateTime @default(now())

  writingDesk WritingDeskDocument @relation(fields: [writingDeskId], references: [id], onDelete: Cascade)

  @@index([writingDeskId, createdAt])
}
