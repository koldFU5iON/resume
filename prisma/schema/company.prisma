// ------------------------------------------------------------
// COMPANIES (shared across users — public facts only)
// ------------------------------------------------------------
// Per-user history (applications, contacts, outcomes) never goes here; it
// stays keyed by profileId. See docs/superpowers/specs/2026-11-11-job-deep-dive-design.md §4.2.

model Company {
  id             String   @id @default(cuid())
  /// Display name, as first seen (register or job).
  name           String
  /// Matching key: see normalizeCompanyName in src/modules/companies/normalize.ts.
  normalizedName String   @unique
  /// Other normalised spellings, e.g. trading names ("X LTD T/A Y"). Written only by the
  /// register import: user-entered job names never add aliases (they're shared matching keys).
  aliases        String[]
  /// True for register entries the import stored (only those named in someone's job). Companies
  /// created from job names stay false and never outrank register names or aliases in matching.
  fromRegister   Boolean  @default(false)
  domain         String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sponsorLicences SponsorLicence[]
  research        CompanyResearch[]
  jobApplications JobApplication[]

  @@index([aliases], type: Gin)
  @@index([fromRegister])
}

/// One row of the Home Office register of licensed sponsors (workers).
model SponsorLicence {
  id          String   @id @default(cuid())
  companyId   String
  /// 'GB' (room for other registers later).
  country     String
  /// As written in the register (trimmed).
  orgName     String
  /// '' when the register leaves it blank, so the unique key works.
  townCity    String   @default("")
  county      String?
  /// e.g. "Worker (A rating)"
  typeRating  String
  /// e.g. "Skilled Worker"
  route       String
  firstSeenAt DateTime
  /// Set by every import that lists this row. Older than the latest complete import = licence lost.
  lastSeenAt  DateTime

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // The register repeats an org + route in different towns (779 pairs in Nov 2026).
  @@unique([country, orgName, townCity, route])
  @@index([companyId])
  @@index([lastSeenAt])
}

/// One import run, for troubleshooting and for "current" licence checks.
model SponsorRegisterImport {
  id          String    @id @default(cuid())
  country     String    @default("GB")
  sourceUrl   String
  /// 'running' | 'complete' | 'failed' ('skipped' on early runs, before every run imported)
  status      String
  rows        Int?
  added       Int?
  removed     Int?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([country, status, startedAt])
}

/// Public research findings about a company, shared across users (deep dive `company`
/// researcher). Researchers never see profile data, so nothing personal is stored here.
/// A row is fresh until expiresAt (createdAt + 30 days); newer rows supersede older ones.
model CompanyResearch {
  id        String   @id @default(cuid())
  companyId String
  /// 'company' (the company researcher's output) for now
  topic     String
  /// Finding[] (src/modules/deep-dive/schema.ts)
  findings  Json
  /// Model that did the search
  model     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, topic, createdAt])
}
