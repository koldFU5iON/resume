// Better Auth OAuth Provider 1.6.11 and JWT plugin storage.
model Jwks {
  id         String    @id
  publicKey  String
  privateKey String
  createdAt  DateTime
  expiresAt  DateTime?

  @@map("jwks")
}

model OauthClient {
  id                      String    @id
  clientId                String    @unique
  clientSecret            String?
  disabled                Boolean?  @default(false)
  skipConsent             Boolean?
  enableEndSession        Boolean?
  subjectType             String?
  scopes                  String[]  @default([])
  userId                  String?
  createdAt               DateTime?
  updatedAt               DateTime?
  name                    String?
  uri                     String?
  icon                    String?
  contacts                String[]  @default([])
  tos                     String?
  policy                  String?
  softwareId              String?
  softwareVersion         String?
  softwareStatement       String?
  redirectUris            String[]
  postLogoutRedirectUris  String[]  @default([])
  tokenEndpointAuthMethod String?
  grantTypes              String[]  @default([])
  responseTypes           String[]  @default([])
  public                  Boolean?
  type                    String?
  requirePKCE             Boolean?
  referenceId             String?
  metadata                Json?

  user          User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens OauthRefreshToken[]
  accessTokens  OauthAccessToken[]
  consents      OauthConsent[]

  @@index([userId])
  @@map("oauthClient")
}

model OauthRefreshToken {
  id          String    @id
  token       String    @unique
  clientId    String
  sessionId   String?
  userId      String
  referenceId String?
  expiresAt   DateTime
  createdAt   DateTime
  revoked     DateTime?
  authTime    DateTime?
  scopes      String[]

  client       OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session      Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessTokens OauthAccessToken[]

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@map("oauthRefreshToken")
}

model OauthAccessToken {
  id          String   @id
  token       String   @unique
  clientId    String
  sessionId   String?
  userId      String?
  referenceId String?
  refreshId   String?
  expiresAt   DateTime
  createdAt   DateTime
  scopes      String[]

  client  OauthClient        @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  session Session?           @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  user    User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  refresh OauthRefreshToken? @relation(fields: [refreshId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([sessionId])
  @@index([userId])
  @@index([refreshId])
  @@map("oauthAccessToken")
}

model OauthConsent {
  id          String   @id
  clientId    String
  userId      String?
  referenceId String?
  scopes      String[]
  createdAt   DateTime
  updatedAt   DateTime

  client OauthClient @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  user   User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@unique([clientId, userId])
  @@map("oauthConsent")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}
